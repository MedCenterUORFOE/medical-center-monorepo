{
  "name": "medical-center-monorepo",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "postinstall": "cd packages/db && npx prisma generate"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "turbo": "2.9.12"
  },
  "dependencies": {
    "eslint-config-next": "14.1.4",
    "next": "14.1.4"
  }
}